# Copy to .env and fill in — .env is gitignored/dockerignored and is never
# baked into the image; docker-compose reads it at container-start time only.

# Existing external Postgres/PostGIS server (state/LGA/ward boundaries,
# building footprints, settlements, etc.) — not containerized here.
# The Docker host needs the same network path to this host:port that your
# machine currently has (VPN/office network, if applicable).
HOST=
PORT=5432
DB=
# NOTE: USER is one of the app's required variable names, and it's also a
# common name that base images/orchestrators sometimes pre-set. Confirm after
# the container starts that this is landing correctly:
#   docker compose exec app env | grep -E '^(HOST|PORT|DB|USER|PASSWORD)='
USER=
PASSWORD=

# ENVIRONMENT is no longer read by the app (toolbox/utils/credential.py was
# fixed to load credentials the same way regardless of its value — see
# DOCKERIZATION_PLAN.md, quirk #1) — no need to set it here anymore.

# Optional. Comma-separated origins allowed to call this API from a browser
# (added for src/frontend — see sda_toolbox.py). Defaults to Vite's default
# dev/preview ports if unset, so you only need this for a non-default port
# or a deployed frontend origin.
# Note: under `docker compose` this is picked up via env_file regardless;
# for a local (non-Docker) run, it needs to be a real exported environment
# variable rather than just a line in .env — credential.py's load_dotenv()
# call happens lazily on first DB access, which can be after this is read.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Read by docker-compose.yml (not the app itself) at `docker
# compose build` time — passed as the frontend image's VITE_API_BASE_URL
# build ARG, i.e. the API URL a browser loading the dockerized frontend
# will call. Vite bakes this into the built JS, so changing it means
# rebuilding the frontend image (`docker compose build frontend`), not just
# restarting the container. Defaults to http://localhost:8000 — this same
# compose file's own published backend port — if unset, which is correct
# for running both services locally. Set this to the backend's real public
# URL for any other deployment (the shared cloud instance).
# FRONTEND_API_BASE_URL=http://localhost:8000
