# Copy to .env (gitignored) and adjust to how you're running the backend locally.
#
# - `uvicorn toolbox.sda_toolbox:app --reload --port 8000` (or the Docker
#   compose service, which also publishes 8000)              -> port 8000
# - `python src/toolbox/sda_toolbox.py` (the ngrok dev workflow)  -> port 5000
VITE_API_BASE_URL=http://localhost:8000
